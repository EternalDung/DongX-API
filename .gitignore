*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env
.env
.env.local

# SQLx offline data (regenerate with `cargo sqlx prepare`)
# .sqlx/ — uncomment to ignore, but keep for CI builds

# Vite build-artifact backups (workaround for safe-delete shim)
dist_bak*/
# 前导下划线变体（如 _dist_bak_old）同样排除，避免 git add -A 误提交备份目录
_dist_bak*/
